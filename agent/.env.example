# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不要提交）
#
# 阿里云百炼 API Key (必需，用于 LLM 和 Embedding)
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
MODEL=qwen-plus
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Redis 配置 (用于短期记忆)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=1800

# Milvus 配置 (用于长期记忆 / 语义缓存 / 向量 RAG)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_API_KEY=

# Neo4j 配置 (用于知识图谱)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# MySQL 配置 (用于订单/实例查询)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cloud_platform

# 日志级别
LOG_LEVEL=INFO
